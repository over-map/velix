  "motion": {
    "press": {
      "durationMs": 120,
      "curve": "easeOut",
      "use": "Scale 0.96 on tap",
      "reduceMotion": "Opacity only"
    },
    "sheetSnap": {
      "durationMs": 350,
      "curve": "spring(response 0.35, damping 0.86)",
      "use": "Detent changes",
      "reduceMotion": "Crossfade 150 ms"
    },
    "routeDrawIn": {
      "durationMs": 600,
      "curve": "easeOut",
      "use": "Best route draws start → end, alt fades in 200 ms later",
      "reduceMotion": "Lines appear at once"
    },
    "viewMode": {
      "durationMs": 450,
      "curve": "easeInOut",
      "use": "2D ↔ 3D pitch 0° ↔ 50°, North-up rotate",
      "reduceMotion": "Cut with 150 ms fade"
    },
    "hazardApproach": {
      "durationMs": 250,
      "curve": "easeOut",
      "use": "NextHazardCard fills with hazard + haptic",
      "reduceMotion": "Colour change only, no slide"
    },
    "banner": {
      "durationMs": 250,
      "curve": "easeOut",
      "use": "NoticeBanner slides from top",
      "reduceMotion": "Fade"
    }
  },
